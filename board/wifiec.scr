# Read-only Wi-Fi evidence from the running vendor system.
# The telnetd here asks for a login (root / ${ZTE_TELNET_PW}) and locks out for 60 s
# after three bad attempts, so the handshake is expect-style, not blind.
EXPECT Login:
SENDLN root
EXPECT Password:
SENDLN ${ZTE_TELNET_PW}
EXPECT #
SENDLN echo V1_PCI; ls /sys/bus/pci/devices/; echo --drivers--; ls /sys/bus/pci/drivers/
WAIT 3000
SENDLN echo V2_IDENT; for d in /sys/bus/pci/devices/*; do echo "$d $(cat $d/vendor):$(cat $d/device) class=$(cat $d/class) irq=$(cat $d/irq)"; done
WAIT 3000
SENDLN echo V3_DMESG; dmesg | grep -iE "pcie|phy|link|mt7|14c3|perst|reset" | head -25
WAIT 3000
SENDLN echo V4_IF; ls /sys/class/net/; echo --; cat /sys/class/net/wlan0/operstate /sys/class/net/wlan0/address 2>&1
WAIT 2500
SENDLN echo V5_WIFI; ls /wlan 2>/dev/null | head -8; echo --; cat /proc/capability/portinfo 2>/dev/null | head -3
WAIT 2500
SENDLN echo V6_INT; grep -iE "pcie|phy" /proc/interrupts
WAIT 2500
SENDLN echo V7_MODS; cat /proc/modules | cut -d" " -f1 | tr "\n" " "
WAIT 2500
SENDLN echo V8_GPIO; cat /sys/kernel/debug/gpio 2>/dev/null | head -40
WAIT 3000
SENDLN echo V9_MTDS; cat /proc/mtd
WAIT 2500
SENDLN echo VA_WLANSVC; ls /etc/init.d/ | grep -iE "lan|wifi|wlan"; echo --; grep -riE "gpio|perst|power" /etc/init.d/*wlan* /etc/init.d/*wifi* 2>/dev/null | head -12
WAIT 3000
SENDLN echo VZ_END
WAIT 1000
SENDLN exit
