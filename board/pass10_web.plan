1000|root
3000|${ZTE_TELNET_PW}
9000|
12000|echo D1; ls /
16000|echo D2; ls /www /rom /usr/lib 2>&1
22000|echo D3; grep -E ":0050 |:1F95 |:1F96 " /proc/net/tcp /proc/net/tcp6 2>&1
