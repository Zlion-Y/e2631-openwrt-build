# pass1: slot geometry + versionstates + partition table (read-only)
EXPECT (?i)user\s?name:|login:
SENDLN root
EXPECT (?i)password:
SENDLN <redacted:vendor telnet password>
EXPECT [#>]\s*$
WAIT 300
SENDLN echo Q1_VERSIONSTATES; cat /proc/zte/verinfo/versionstates
EXPECT [#>]\s*$
SENDLN echo Q2_VERINFO_DIR; ls -l /proc/zte/verinfo/ /proc/zte/ 2>&1
EXPECT [#>]\s*$
SENDLN echo Q3_OTHERVER; for f in /proc/zte/verinfo/*; do echo "== $f"; cat $f 2>&1; done
EXPECT [#>]\s*$
SENDLN echo Q4_PROCMTD; cat /proc/mtd
EXPECT [#>]\s*$
SENDLN echo Q5_DMESG_PART; dmesg 2>/dev/null | grep -i -E "0x0000|partition|mtd|nand|spifc|denali|erase" | head -80
EXPECT [#>]\s*$
SENDLN echo Q6_DONE; echo ALLDONE
