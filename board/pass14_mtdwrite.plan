1000|root
3000|${ZTE_TELNET_PW}
9000|
12000|echo H1; ls -l /dev/mtd0 /dev/mtdblock0 /dev/mtd6 /dev/mtd7
18000|echo H2; for i in 0 6 7 8; do echo -n "mtd$i flags="; cat /sys/class/mtd/mtd$i/flags; echo -n "  type="; cat /sys/class/mtd/mtd$i/type; done
26000|echo H3; ls -l /sbin | grep -i -E "env|fw_|boot|syn_|version"
34000|echo H4; which fw_printenv printenv fw_setenv; ls /etc/fw_env.config 2>&1
42000|echo H5; cat /proc/mtd | grep -c mtd
48000|echo H6; ls /bin | grep -i -E "flash|mtd|erase|dd"
