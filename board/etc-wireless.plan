1500|root
4500|${ZTE_TELNET_PW}
8000|echo X1; ls -l /etc/wireless /etc/wireless/mt7916 2>&1
14000|echo X2; ls -l /lib/firmware 2>&1; ls -d /lib/firmware 2>&1
20000|echo X3; for f in /etc/wireless/mt7916/*; do ls -l $f; done 2>&1
34000|echo X4; for f in /etc/wireless/mt7916/*.bin; do md5sum $f; done 2>&1
58000|echo X5; for f in /etc/wireless/mt7916/*; do sha256sum $f; done 2>&1
86000|exit
