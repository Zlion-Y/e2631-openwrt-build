1500|root
4500|<redacted:vendor telnet password>
8000|echo C1; ls -l /userconfig /usercfg /defcfg 2>&1
14000|echo C2; for f in /userconfig/* /usercfg/*; do ls -l $f; done 2>&1
22000|echo C3; /bin/busybox grep -a -c . /userconfig/* 2>&1
28000|echo C4; /bin/busybox grep -a -i -m 20 -E "passw|Pwd|pwd" /userconfig/* 2>&1
40000|echo C5; /bin/busybox grep -a -i -m 12 -E "WebAccount|UserName|AccountName|telecomadmin|CMCCAdmin" /userconfig/* /usercfg/* 2>&1
50000|echo C6; /bin/busybox sed -n 1,40p /userconfig/db_user_cfg.xml 2>&1
70000|echo C7; ls -l /etc/lighty* /etc/httpd* /etc/conf/httpd* 2>&1
80000|exit
