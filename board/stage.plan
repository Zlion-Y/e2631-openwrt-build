1000|root
3000|${ZTE_TELNET_PW}
9000|
12000|echo S1; rm -f /var/tmp/e2631-fwslot /var/tmp/fw.bin /var/tmp/flash.log; df -k /var /tmp; mount | grep -E " /var| /tmp"; which setsid nohup curl; cat /proc/mtd; ls -l /dev/mtd* 2>/dev/null
18000|echo S2; curl -f --connect-timeout 5 --max-time 240 -o /var/tmp/e2631-fwslot http://192.168.5.5:8001/e2631-fwslot; echo rc=$?; chmod +x /var/tmp/e2631-fwslot; ls -l /var/tmp/e2631-fwslot
24000|:
30000|echo S3; curl -f --connect-timeout 5 --max-time 240 -o /var/tmp/fw.bin http://192.168.5.5:8001/fw.bin; echo rc=$?; ls -l /var/tmp/fw.bin
36000|:
46000|echo S4; /var/tmp/e2631-fwslot info
48000|:
58000|echo S5; /var/tmp/e2631-fwslot check /var/tmp/fw.bin
60000|:
72000|echo S6; rm -f /var/tmp/flash.log; (setsid /var/tmp/e2631-fwslot flash /var/tmp/fw.bin  > /var/tmp/flash.log 2>&1 &); echo started
