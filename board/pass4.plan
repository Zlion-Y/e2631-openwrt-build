1000|root
2500|${ZTE_TELNET_PW}
5000|
7000|echo V1_BOOTFLASH_USAGE; boot_flashing
11000|echo V2_BOOTFLASH_H; boot_flashing -h
14000|echo V3_FWFLASH_USAGE; fw_flashing
18000|echo V4_FWFLASH_H; fw_flashing -h
22000|echo V5_SYNVER; syn_version
25000|echo V6_UPGRADETEST; upgradetest -h
29000|echo V7_DECRYPT_PROOF; busybox hexdump -C -n 32 /dev/mtdblock8; busybox hexdump -C -s 0xa40000 -n 32 /dev/mtdblock0; busybox hexdump -C -s 0x2640000 -n 32 /dev/mtdblock0
35000|echo V8_KALLSYMS; busybox grep -i -E "aes|crypt|decrypt|encrypt|slot|verinfo|verhdr|zteboot" /proc/kallsyms | busybox head -60
40000|echo V9_IOMEM; cat /proc/iomem
45000|echo V10_LSMOD; lsmod
50000|echo V11_FDT; ls -l /sys/firmware/ /proc/device-tree/
