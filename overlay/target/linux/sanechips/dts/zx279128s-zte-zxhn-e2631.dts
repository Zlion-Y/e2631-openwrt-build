// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
/*
 * ZTE ZXHN E2631 (a.k.a. 巡天 AX3000): dual-band Wi-Fi 6 router on the
 * Sanechips ZX279128(S/R) SoC, 256 MiB DDR, 128 MiB SPI NAND, one WAN and
 * three LAN ports, all served by the four integrated GbE PHYs.
 *
 * Hardware facts below were read off a live board (2026-10-13) and are marked
 * with where they came from. Values still needing confirmation on first boot
 * are called out in comments - do not treat them as measured.
 */

/dts-v1/;

#include "zte/zx279128s.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "ZTE ZXHN E2631";
	compatible = "zte,zxhn-e2631", "zte,zx279128s";

	aliases {
		ethernet0 = &gmac;
		serial0 = &serial0;
		serial1 = &serial1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		/* /proc/capability/boardtype: totalram 256M; vendor cmdline mem=256M */
		reg = <0x40000000 0x10000000>;
	};


	leds {
		compatible = "gpio-leds";

		/* Vendor ledkey table (/proc/zte/ledkey_m/led) lists three LEDs on flat
		 * GPIO 8/40/60; flat = controller*16 + line, the convention
		 * gpio-zx279128s uses (six banks of 16 lines). Two samples of
		 * CurrentOnOff taken an hour apart on the vendor system disagree about
		 * which lamp is lit: 3 minutes after a reboot it was gpio 40, in a fully
		 * settled system it was gpio 60, and gpio 8 was never lit. The
		 * bootloader drives 8 and 40 high and 60 low.
		 *
		 * So 40 is the lamp that is lit earliest, which is what a power LED
		 * does, and its lit level is high in the U-Boot phase. That is a reasoned
		 * call, not a measurement: these bank registers cannot be read to check
		 * it, because reading them from the vendor system hangs the SoC and the
		 * watchdog reboots the box (observed 2026-10-13). On first boot read the
		 * panel: if the lamp we drive stays dark, swap this line to
		 * GPIO_ACTIVE_LOW and try 60 (&gpio3 12) in its place.
		 * Which of 8 and 60 is the internet / wlan lamp is still unknown.
		 */
		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_internet: led-internet {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&gpio3 12 GPIO_ACTIVE_LOW>;
		};

		led_wlan: led-wlan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		/* Polled on purpose: the ZTE GPIO IRQ chip is unvalidated on this
		 * family and a gpio-keys irq-mode probe locked the H3600 up.
		 * Vendor key table (/proc/zte/ledkey_m/key): flat GPIO 18 and 20.
		 */
		compatible = "gpio-keys-polled";
		poll-interval = <50>;

		key-reset {
			label = "reset";
			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		key-wps {
			label = "wps";
			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};
};

/*
 * Port mapping read from the running vendor system,
 * /proc/capability/ethernetmac (PhyMnf "ZTE" on all four => no external PHY,
 * unlike the H3600 which hangs its WAN off a ZX5201 at MDIO address 8):
 *
 *   eth0 -> switch port 3   not in br0, PROMISC uplink  = WAN
 *   eth1 -> switch port 2   in br0                      = LAN
 *   eth2 -> switch port 1   in br0                      = LAN
 *   eth3 -> switch port 0   in br0                      = LAN
 *
 * The MDIO addresses of the four integrated PHYs are taken from the H3600
 * board file (0xa..0xd) and are UNVERIFIED on this board. Confirm on first
 * boot from our own kernel - "ls /sys/bus/mdio_bus/devices" must show
 * 0-000a..0-000d, and each must report the sanechips GbPHY id - before this
 * ships. Never probe MDIO by poking the controller under the vendor system:
 * writing CMD/STATUS there reset the board within seconds.
 */
&gmac {
	status = "okay";
};

&gmac_port0 {
	label = "lan3";
	phy-handle = <&phy10>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port1 {
	label = "lan2";
	phy-handle = <&phy11>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port2 {
	label = "lan1";
	phy-handle = <&phy12>;
	phy-mode = "internal";
	status = "okay";
};

&gmac_port3 {
	label = "wan";
	phy-handle = <&phy13>;
	phy-mode = "internal";
	status = "okay";
};

/* Only four ports are wired on this board; the SoC offers a fifth. */
&gmac_port4 {
	status = "disabled";
};

&mdio {
	status = "okay";

	phy10: ethernet-phy@a {
		reg = <10>;
	};

	phy11: ethernet-phy@b {
		reg = <11>;
	};

	phy12: ethernet-phy@c {
		reg = <12>;
	};

	phy13: ethernet-phy@d {
		reg = <13>;
	};
};

/*
 * MT7916 dual-band Wi-Fi 6 (vendor lsmod: mt7916, out of tree; the calibration
 * file in the "wifi" partition starts with 16 79 = chip id 0x7916 and is the
 * only file there, 0x30000 bytes, mounted by the vendor at /wlan).
 *
 * One package behind both PCIe controllers, as on the H3600, whose vendor
 * driver is the same MediaTek code family. The reset GPIO number is inherited
 * from the H3600 board file and is NOT measured on this board: if nothing
 * enumerates on pci0/01, check this line first (the H3600 also drives an
 * enable-gpios on &gpio3 7, left out here on purpose until PCIe is seen).
 */
&pcie0 {
	reset-gpios = <&gpio3 5 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pcie1 {
	status = "okay";
};

/* No USB on this board: the vendor kernel ships "# CONFIG USB is not set" and
 * on some E2631 units the controller is not populated at all - probing it
 * hangs the SoC and the watchdog reboots. Leave both nodes disabled.
 */
&usb {
	status = "disabled";
};

&spifc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <1>;

		/* HYF1GQ4UTACAE: 128 MiB, 2 KiB pages, 128 KiB erase blocks */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0000000 0x0100000>;
				read-only;
			};

			partition@100000 {
				label = "tag";
				reg = <0x0100000 0x0100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* LAN MAC; WAN uses the next one (H3600 convention,
					 * verify against the vendor web UI before shipping)
					 */
					macaddr_tag_1e: macaddr@1e {
						compatible = "mac-base";
						reg = <0x1e 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@200000 {
				label = "wifi";
				reg = <0x0200000 0x0100000>;
			};

			partition@300000 {
				label = "usercfg";
				reg = <0x0300000 0x0200000>;
				read-only;
			};

			partition@500000 {
				label = "defcfg";
				reg = <0x0500000 0x0200000>;
				read-only;
			};

			/*
			 * The system lives in two whole-image slots, declared by every
			 * official upgrade package (header +0x4c/+0x5c) and confirmed by
			 * /proc/zte/verinfo/versionstates: 0x700000..0x2300000 and
			 * 0x2300000..0x3f00000, 28 MiB each. Slot 0 keeps the vendor
			 * system; OpenWrt is installed into slot 1, so that
			 * "e2631-fwslot switch" can boot the vendor side again without
			 * rewriting a byte of it.
			 *
			 * rootfs, slot1-header and rootfs_data are windows into slot1, the
			 * same way the vendor table overlaps "rootfs" inside "kernel1".
			 * They stay flat on purpose: mainline ofpart only looks for
			 * sub-partitions when the partition node itself carries
			 * "compatible = fixed-partitions", and then their offsets are
			 * relative. One flat table keeps every address an absolute flash
			 * offset, which is also what e2631-fwslot matches against
			 * /sys/class/mtd/mtdN/offset.
			 *
			 * Inside slot 1 our package is laid out as
			 *   +0x000000  32-byte slot marker
			 *   +0x000020  kernel (plaintext legacy uImage, load 0x40008000),
			 *                padded to fill the region up to +0x400000
			 *   +0x400000  squashfs, padded to fill up to +0xc00000
			 *   +0xc00000  the 512-byte version header block
			 *   +0xc20000  overlay (rootfs_data) up to the end of the slot
			 *
			 * +0x400000 is not a free choice. cspboot locates the rootfs as
			 * "slot + ceil(declared kernel size / 128k)" and ignores the header's
			 * own rootfs offset (proved on the serial console: a kernel of
			 * 0x34bdf8 made it read slot+0x360000, rejected the CRC and fell back
			 * to slot 0). The packer therefore declares the padded kernel extent
			 * 0x3fffe0, whose rounded-up value is exactly +0x400000, which is also
			 * why KERNEL_SIZE is capped at 4096k: a kernel that outgrows this
			 * region must fail the build, not move the rootfs under the table.
			 *
			 * Those fixed addresses hold only while no erase block of
			 * [slot start, +0xc00000) is bad; e2631-fwslot checks that and
			 * refuses to write when it is not.
			 */
			partition@700000 {
				label = "slot0";
				/* Deliberately not read-only: switching back to the stock
				 * firmware rewrites the version header inside this slot, and
				 * "read-only" masks MTD_WRITEABLE off the partition, which
				 * would make that impossible. e2631-fwslot refuses to flash
				 * into slot 0 instead.
				 */
				reg = <0x00700000 0x01c00000>;
			};

			partition@2300000 {
				label = "slot1";
				reg = <0x02300000 0x01c00000>;
			};

			partition@2700000 {
				label = "rootfs";
				reg = <0x02700000 0x00800000>;
			};

			partition@2f00000 {
				label = "slot1-header";
				reg = <0x02f00000 0x00020000>;
			};

			partition@2f20000 {
				label = "rootfs_data";
				reg = <0x02f20000 0x00fe0000>;
			};

			/* Vendor plugin area: 0x6e00000..0x7f00000 on this board. Left
			 * alone; it is AES-128-ECB at rest and only readable through the
			 * vendor kernel.
			 */
		};
	};
};
