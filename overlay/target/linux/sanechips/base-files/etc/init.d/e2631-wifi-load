#!/bin/sh /etc/rc.common
# Load the MT7916 after boot, and only when asked to.
#
# Two reasons this is not done from START=05 any more:
#  - the boot-time stall always sat inside rc.d (console died during the firmware
#    DMA window, before ssh came up), so an unlucky boot was unrecoverable;
#  - with the load deferred, a bad experiment costs one reboot instead of a
#    locked-out boot.
#
# Autoload is opt-in through /etc/e2631-wifi-autoload: while the association
# hang is still being chased, the deterministic boot is worth more than a
# self-starting radio.  Create the file (and reboot, or run
# /sbin/e2631-wifi-on 0 by hand) once Wi-Fi at boot is the thing under test.
START=95
USE_PROCD=1
AUTOLOAD=/etc/e2631-wifi-autoload
DEFER=${DEFER:-25}

start_service() {
	[ -e "$AUTOLOAD" ] || { echo "wifi-load: no $AUTOLOAD, radio stays off until 'e2631-wifi-on'" > /dev/kmsg; return 0; }
	procd_open_instance wifi-load
	procd_set_param command /sbin/e2631-wifi-on "$DEFER"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
