#!/bin/sh /etc/rc.common
# Runs /sbin/e2631-trial as a one-shot service on boot: the image has to be
# accepted with e2631-commit or the box reverts to the stock firmware slot.
START=99
USE_PROCD=1

start_service() {
	[ -f /etc/e2631-accepted ] && return 0

	procd_open_instance trial
	procd_set_param command /sbin/e2631-trial
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
