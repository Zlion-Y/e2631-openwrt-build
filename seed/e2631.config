# Seed .config for the E2631 build. Intentionally minimal on the first run:
# LuCI and the Wi-Fi stack are commented out so a green baseline comes back
# quickly, then get added one at a time.
CONFIG_TARGET_sanechips=y
CONFIG_TARGET_sanechips_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_sanechips_generic_DEVICE_zte_zxhn-e2631=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

CONFIG_PACKAGE_e2631-fwslot=y

# Debug and console helpers, cheap and needed while the port is untested.
CONFIG_PACKAGE_minicom=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_COLLECT_KERNEL_DEBUG=y

# Next iterations:
# CONFIG_PACKAGE_luci=y
# CONFIG_PACKAGE_luci-ssl-openssl=y
# CONFIG_PACKAGE_kmod-mt7915e=y
# CONFIG_PACKAGE_kmod-mt7915-firmware=y
# CONFIG_PACKAGE_wireless-regdb=y
# CONFIG_PACKAGE_kmod-usb3 is deliberately never enabled: this board has no
# usable USB and probing the controller reboots it.
